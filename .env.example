# Copia este archivo a .env y completa los valores reales.
# Nunca subas .env al repositorio.

CI_ENVIRONMENT = development

# En producción se recomienda fijar el dominio y desactivar la detección.
# app.baseURL = 'https://tudominio.com/'
# app.autoDetectBaseURL = false

# reCAPTCHA v2: ambas claves son obligatorias para recibir solicitudes.
RECAPTCHA_SITE_KEY =
RECAPTCHA_SECRET_KEY =

# Base de datos (SQLite por defecto en desarrollo).
database.default.hostname = localhost
database.default.database = database.db
database.default.username =
database.default.password =
database.default.DBDriver = SQLite3
database.default.DBPrefix =
database.default.pConnect = false
database.default.DBDebug = true
database.default.charset = utf8
database.default.DBCollat = utf8_general_ci
database.default.port = 3306

# Contraseña usada solo al ejecutar el seeder del primer administrador.
# SEED_ADMIN_PASSWORD =
